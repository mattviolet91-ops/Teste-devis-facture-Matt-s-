# Configuration pour o2switch. Copier ce fichier en « .env » puis remplir les
# valeurs entre < >. Ne jamais envoyer le fichier .env sur GitHub.

APP_NAME="Matt's Couverture"
# « staging » pour l'installation de test, « production » pour la vraie.
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://test.matts-couverture.fr
CLIENT_URL=https://test.matts-couverture.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<nom_de_la_base>
DB_USERNAME=<utilisateur_de_la_base>
DB_PASSWORD=<mot_de_passe_de_la_base>

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# Emails : laissé sur « log » pour le test (aucun email envoyé).
MAIL_MAILER=log
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=mv.entreprise91@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="mv.entreprise91@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
